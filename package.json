{
  "name": "semantic-dom-ssg",
  "version": "0.3.0",
  "description": "Machine-readable web semantics for AI agents: SemanticDOM and Semantic State Graph with O(1) lookup, deterministic IDs and navigation, token-efficient serialization, MCP server, React hooks and ESLint rules",
  "author": "George Alexander <info@gorgalxandr.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vanilla": {
      "import": {
        "types": "./dist/vanilla.d.ts",
        "default": "./dist/vanilla.js"
      },
      "require": {
        "types": "./dist/vanilla.d.cts",
        "default": "./dist/vanilla.cjs"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.js"
      }
    },
    "./eslint-plugin": {
      "import": {
        "types": "./dist/eslint-plugin.d.ts",
        "default": "./dist/eslint-plugin.js"
      },
      "require": {
        "types": "./dist/eslint-plugin.d.cts",
        "default": "./dist/eslint-plugin.cjs"
      }
    },
    "./toon": {
      "import": {
        "types": "./dist/toon.d.ts",
        "default": "./dist/toon.js"
      },
      "require": {
        "types": "./dist/toon.d.cts",
        "default": "./dist/toon.cjs"
      }
    },
    "./mcp": {
      "import": {
        "types": "./dist/mcp.d.ts",
        "default": "./dist/mcp.js"
      },
      "require": {
        "types": "./dist/mcp.d.cts",
        "default": "./dist/mcp.cjs"
      }
    },
    "./summary": {
      "import": {
        "types": "./dist/summary.d.ts",
        "default": "./dist/summary.js"
      },
      "require": {
        "types": "./dist/summary.d.cts",
        "default": "./dist/summary.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "semantic-dom": "./dist/bin.js",
    "ssg-validate": "./dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:sizes": "node scripts/check-file-sizes.mjs",
    "check:package": "node scripts/check-package.mjs",
    "verify": "npm run check:sizes && npm run typecheck && npm run lint && npm run test && npm run build && npm run check:package",
    "prepublishOnly": "npm run verify",
    "clean": "rm -rf dist coverage"
  },
  "keywords": [
    "semantic-dom",
    "ssg",
    "semantic-state-graph",
    "a11y",
    "accessibility",
    "ai-agent",
    "web-automation",
    "dom-parsing",
    "iso-standard",
    "react-hooks",
    "typescript",
    "agentic-web",
    "toon",
    "toon-format",
    "llm",
    "token-optimization",
    "mcp",
    "model-context-protocol",
    "agentic-ai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gorgalxandr/semantic-dom-ssg.git"
  },
  "bugs": {
    "url": "https://github.com/gorgalxandr/semantic-dom-ssg/issues"
  },
  "homepage": "https://github.com/gorgalxandr/semantic-dom-ssg#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "eslint": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "latest",
    "tsup": "9.0.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "optionalDependencies": {
    "jsdom": "31.0.1"
  },
  "dependencies": {
    "@toon-format/toon": "4.4.0",
    "commander": "15.1.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
